{
  "name": "kharos",
  "private": true,
  "version": "0.1.0",
  "license": "MPL-2.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "vite apps/web",
    "server": "bun apps/server/main.ts",
    "typecheck": "bun run --filter '*' typecheck",
    "build": "bun run typecheck && vite build apps/web",
    "build:wasm": "cargo build -p kharos-sim-wasm --target wasm32-unknown-unknown --release",
    "bundle:native": "tsc -p apps/native/tsconfig.json && vite build --config apps/native/vite.config.ts",
    "preview": "vite preview apps/web",
    "test": "bun test",
    "balance": "bun tools/balance.ts",
    "stress": "bun tools/stress.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "@kharos/tsconfig": "*"
  },
  "dependencies": {
    "acme-client": "^5.4.0",
    "@kharos/ecs": "*",
    "@kharos/i18n": "*",
    "@kharos/shared": "*",
    "@kharos/sim-ts": "*",
    "@kharos/mods": "*",
    "@kharos/data": "*",
    "@kharos/base": "*",
    "@kharos/protocol": "*",
    "@kharos/host": "*",
    "@kharos/client": "*"
  }
}
