<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CetCompat>false</CetCompat>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Kharos.Gpu\Kharos.Gpu.csproj" />
    <!-- Земля для кадров — настоящим генератором; сам Kharos.Gpu движок не знает. -->
    <ProjectReference Include="..\..\src\Kharos.Engine\Kharos.Engine.csproj" />
    <!-- Сверка кадров с TS (Parity.NetFrame): сцены собирает Viewer на сценарии base (docs/dotnet-n6.md, Н6.4). -->
    <ProjectReference Include="..\Kharos.Base.Scenario\Kharos.Base.Scenario.csproj" />
    <!-- Скрытое окно — проверка поверхности и переноса кадра в окно; на экране ничего не появляется. -->
    <PackageReference Include="Silk.NET.Windowing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- Упавшие тесты в CI — аннотациями запуска. -->
    <PackageReference Include="GitHubActionsTestLogger" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
