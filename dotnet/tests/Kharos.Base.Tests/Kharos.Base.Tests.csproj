<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Без теневого стека CET: ловушки Wasmtime на Windows (см. Kharos.Plugins.Tests). -->
    <CetCompat>false</CetCompat>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Kharos.Host\Kharos.Host.csproj" />
    <ProjectReference Include="..\..\src\Kharos.Content\Kharos.Content.csproj" />
    <ProjectReference Include="..\..\src\Kharos.Protocol\Kharos.Protocol.csproj" />
    <!-- Клиент партии: сквозные тесты подачи base (host.wasm + client.wasm) и сверка обликов. -->
    <ProjectReference Include="..\..\src\Kharos.Client\Kharos.Client.csproj" />
    <ProjectReference Include="..\..\src\Kharos.Mod.Sdk\Kharos.Mod.Sdk.csproj" />
    <!-- Обвязка сценариев: Sim.Create, Advance, Send, правки edit.* и сохранение (docs/dotnet-n5.md, Н5.6). -->
    <ProjectReference Include="..\Kharos.Base.Scenario\Kharos.Base.Scenario.csproj" />
    <!-- Балансный харнесс (tools/Kharos.Balance): BalanceTests сверяют его вывод с эталонами TS из Balance/golden. -->
    <ProjectReference Include="..\..\tools\Kharos.Balance\Kharos.Balance.csproj" />
    <!-- Общее base: данные, имена, приказы — то же, что в host.wasm и client.wasm. -->
    <ProjectReference Include="..\..\mods\base\Base.Shared\Base.Shared.csproj" />
    <!-- Звук base: движок звука (офлайн, без устройства). -->
    <ProjectReference Include="..\..\src\Kharos.Audio\Kharos.Audio.csproj" />
    <PackageReference Include="MemoryPack" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- Упавшие тесты в CI — аннотациями запуска. -->
    <PackageReference Include="GitHubActionsTestLogger" PrivateAssets="all" />
    <!-- Картинки атласов и кадров для просмотра глазами: dotnet/.cache/base/. -->
    <PackageReference Include="StbImageWriteSharp" />
  </ItemGroup>
  <ItemGroup>
    <!-- Чертежи облика base (юниты, турели, здания Art/Buildings, месторождения) — те же файлы, что в client.wasm: сверка со всеми видами TS. Файлы разделов (*Section.cs) живут на состоянии мода и сюда не входят. -->
    <Compile Include="..\..\mods\base\Base.Client\Art\**\*.cs" Exclude="..\..\mods\base\Base.Client\Art\ArtSection.cs" Link="Base\Art\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Звук клиентской части base (банк, голоса, обработчики) — те же файлы, что в client.wasm. -->
    <Compile Include="..\..\mods\base\Base.Client\Sounds\*.cs" Exclude="..\..\mods\base\Base.Client\Sounds\SoundsSection.cs" Link="Base\Sounds\%(Filename)%(Extension)" />
    <Compile Include="..\..\mods\base\Base.Client\Audio\*.cs" Exclude="..\..\mods\base\Base.Client\Audio\AudioSection.cs" Link="Base\Audio\%(Filename)%(Extension)" />
    <!-- Сетка команд HUD — чистая функция состояния (К3а): те же файлы, что в client.wasm. -->
    <Compile Include="..\..\mods\base\Base.Client\Hud\Commands.cs;..\..\mods\base\Base.Client\Hud\Model.cs;..\..\mods\base\Base.Client\Steps\StepSpec.cs" Link="Base\Hud\%(Filename)%(Extension)" />
    <Compile Include="..\..\mods\base\Base.Client\Panels\Trade.cs" Link="Base\Panels\%(Filename)%(Extension)" />
    <!-- Камера, зона строительства и погода base — чистые модели без состояния мода (К2): те же файлы, что в client.wasm. -->
    <Compile Include="..\..\mods\base\Base.Client\Camera\CameraModel.cs;..\..\mods\base\Base.Client\Camera\Motion.cs;..\..\mods\base\Base.Client\Camera\Shake.cs;..\..\mods\base\Base.Client\Controls\ZoneOutline.cs;..\..\mods\base\Base.Client\Atmosphere\WeatherModel.cs" Link="Base\Camera\%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Kharos.Base.Scenario" />
    <!-- Эталоны графики из TS (dump.ts) — рядом с тестами. -->
    <None Include="Looks\golden\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Эталоны баланса — вывод tools/Kharos.Balance (all с ключом out); прежние из TS лежат в Balance/golden/ts и не копируются. -->
    <None Include="Balance\golden\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
