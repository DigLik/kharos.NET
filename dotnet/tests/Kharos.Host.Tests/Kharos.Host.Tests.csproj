<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Без теневого стека CET: ловушки Wasmtime на Windows (см. Kharos.Plugins.Tests). -->
    <CetCompat>false</CetCompat>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Kharos.Host\Kharos.Host.csproj" />
    <ProjectReference Include="..\..\src\Kharos.Content\Kharos.Content.csproj" />
    <ProjectReference Include="..\..\src\Kharos.Protocol\Kharos.Protocol.csproj" />
    <!-- DetMath для ходовой hello (Wheels.cs) — та же, что в моде. -->
    <ProjectReference Include="..\..\src\Kharos.Mod.Sdk\Kharos.Mod.Sdk.csproj" />
    <!-- Чат с модом base: партия Sim поверх HostSession (ChatTests), приказы мода — Base.Shared. -->
    <ProjectReference Include="..\Kharos.Base.Scenario\Kharos.Base.Scenario.csproj" />
    <PackageReference Include="MemoryPack" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- Упавшие тесты в CI — аннотациями запуска. -->
    <PackageReference Include="GitHubActionsTestLogger" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- Payload приказов мода hello и его ходовая — тот же код, что в host.wasm. -->
    <Compile Include="..\..\mods\hello\Hello.Host\Orders.cs" Link="Hello\Orders.cs" />
    <Compile Include="..\..\mods\hello\Hello.Host\Wheels.cs" Link="Hello\Wheels.cs" />
    <Compile Include="..\..\src\Kharos.Mod.Sdk\Abi\ModAbi.cs" Link="Hello\ModAbi.cs" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
