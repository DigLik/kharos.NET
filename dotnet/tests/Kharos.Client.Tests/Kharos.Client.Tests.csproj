<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Без теневого стека CET: клиентские моды — в Wasmtime (см. Kharos.Plugins.Tests). -->
    <CetCompat>false</CetCompat>
  </PropertyGroup>
  <ItemGroup>
    <!-- Kestrel для тестов транспорта WebSocket: сервер на localhost, как у настоящего. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Kharos.Client\Kharos.Client.csproj" />
    <!-- Хост одиночной игры — партия hello для сквозных тестов клиента. -->
    <ProjectReference Include="..\..\src\Kharos.Host\Kharos.Host.csproj" />
    <!-- Клиент hello в режиме CLR (KHAROS_MODS, по умолчанию CLR): Hello.Client.dll грузится в свою ALC, в процесс не подключается. -->
    <ProjectReference Include="..\..\mods\hello\Hello.Client\Hello.Client.csproj" ReferenceOutputAssembly="false" />
    <!-- Сторона мода: запись потоков SDK сверяется с разбором клиента вне wasm. -->
    <ProjectReference Include="..\..\src\Kharos.Mod.Sdk\Kharos.Mod.Sdk.csproj" />
    <PackageReference Include="MemoryPack" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- Упавшие тесты в CI — аннотациями запуска. -->
    <PackageReference Include="GitHubActionsTestLogger" PrivateAssets="all" />
    <!-- Картинки интерфейса и атласов для просмотра глазами: dotnet/.cache/client/. -->
    <PackageReference Include="StbImageWriteSharp" />
  </ItemGroup>
  <ItemGroup>
    <!-- Мод hello: приказы и клиентский мод — тот же код, что в host.wasm и client.wasm. -->
    <Compile Include="..\..\mods\hello\Hello.Host\Orders.cs" Link="Hello\Orders.cs" />
    <Compile Include="..\..\mods\hello\Hello.Client\HelloClient.cs" Link="Hello\HelloClient.cs" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
