// Энергия (Energy): выключенные и занятые потребители, накопители, реакторы.
{
  // Здание выключено игроком.
  "Off": {},
  // Потребитель занят делом и просит энергию целиком.
  "Busy": {},
  // Накопитель: заряд и поток в этом тике.
  "Accumulator": { "charge": 0, "flow": 0, "@net": "owner" },
  // Реактор: сколько тиков горит стержень.
  "Reactor": { "left": 0, "@net": "owner" },
  // Здание в энергосети (пишет хост в конце тика, читает клиент): net — номер сети среди сетей хозяина с 1 (скрыт от
  // чужих), state — биты GridWire: перегруз, нехватка, под нагрузкой, без главного здания.
  "Grid": { "net": 0, "state": 0, "@private": ["net"] },
  // Сети игрока на сущности счёта (TS zoneEconomies) — записи GridWire подряд, в порядке сетей.
  "Grids": { "nets": null, "@net": "owner" }
}
