// Ядро (Kernel): юниты, здания, прочность, производство, превращения MCV, очереди приказов. Модель — components.ts;
// вид (TS type) — Proto, поворот юнита — Facing, сущности — номером (0 — нет), вид груза, оружия, юнита — номером Proto (−1 — нет).
{
  // Юнит: метка; вид — Proto, поворот — Facing, тело — Body, ход — Mover и Path.
  "Unit": {},
  // Здание: phase — сдвиг анимации, level — уровень с единицы; основание — Footprint.
  "Building": { "phase": 0, "level": 1 },
  // Прочность: value от max до 0; hit — тик последнего попадания (−1 — не попадали).
  "Health": { "value": 1, "max": 1, "repairable": true, "regen": 0, "hit": -1 },
  // Производство: current — вид юнита в работе (−1 — нет), rally — есть ли точка сбора; queue — виды очереди, i32 подряд.
  "Producer": { "progress": 0, "current": -1, "rally": false, "rallyX": 0, "rallyY": 0, "queue": null, "@net": "owner" },
  // Превращение MCV в здание и обратно: сколько тиков осталось и всего.
  "Converting": { "left": 0, "total": 0 },
  // MCV едет разворачиваться: левый верхний тайл места. Куда — тайна, но разворот (Converting) виден всем.
  "Deploys": { "x": 0, "y": 0, "misses": 0, "@net": "owner" },
  // Очередь приказов Shift: list — пары «группа, приказ» (MemoryPack).
  "Orders": { "list": null }
}
