<Project Sdk="Microsoft.NET.Sdk">
  <!-- Клиент: реплика, кадр, камера, атлас обликов, UI, клиентский API модов (docs/dotnet.md, §4.3). -->
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Kharos.Engine\Kharos.Engine.csproj" />
    <ProjectReference Include="..\Kharos.Plugins\Kharos.Plugins.csproj" />
    <ProjectReference Include="..\Kharos.Content\Kharos.Content.csproj" />
    <ProjectReference Include="..\Kharos.Protocol\Kharos.Protocol.csproj" />
    <ProjectReference Include="..\Kharos.Gpu\Kharos.Gpu.csproj" />
    <ProjectReference Include="..\Kharos.Audio\Kharos.Audio.csproj" />
    <!-- Растеризатор шрифтов: управляемый, без платформенных библиотек, безопасен для NativeAOT. -->
    <PackageReference Include="StbTrueTypeSharp" />
    <InternalsVisibleTo Include="Kharos.Client.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Ark Pixel 12 и 10 (OFL, Fonts/OFL.txt) — ресурсами сборки. -->
    <EmbeddedResource Include="Fonts\ark-pixel-12px.otf" LogicalName="Kharos.Client.Fonts.ark-pixel-12px.otf" />
    <EmbeddedResource Include="Fonts\ark-pixel-10px.otf" LogicalName="Kharos.Client.Fonts.ark-pixel-10px.otf" />
    <None Include="Fonts\OFL.txt" CopyToOutputDirectory="PreserveNewest" Link="Fonts\OFL.txt" />
  </ItemGroup>
</Project>
