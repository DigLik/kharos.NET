<Project Sdk="Microsoft.NET.Sdk">
  <!-- Рендер кадра на Silk.NET.WebGPU и WGSL (docs/dotnet.md, §4.3). Контракт кадра — Frame.cs и Batch.cs. -->
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>

    <PackageReference Include="Silk.NET.WebGPU" />
    <PackageReference Include="Silk.NET.WebGPU.Native.WGPU" />
    <PackageReference Include="Silk.NET.WebGPU.Extensions.WGPU" />
    <PackageReference Include="StbImageWriteSharp" />
  </ItemGroup>
  <ItemGroup>
    <!-- Программы WGSL: common.wgsl — общее начало, остальные — по проходу (Pipelines.Source). -->
    <EmbeddedResource Include="Shaders\*.wgsl" LogicalName="Kharos.Gpu.Shaders.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Kharos.Gpu.Tests" />
  </ItemGroup>
</Project>
