<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Набор мододела: API хоста, экспорты ABI (build/ModExports.cs), сборка мода в wasm (build/Kharos.Mod.props/.targets).
    net10.0, а не net11.0: компилятор NativeAOT-LLVM (Microsoft.DotNet.ILCompiler.LLVM 10.0.0-rc.1) несёт библиотеки
    .NET 10 — моды и всё, что в них входит, собираются под них.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Документация открытого API — по существу, не на каждый член. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- DetMath движка собирается и сюда: пространство имён Kharos.Mod.Sdk (см. Math/DetMath*.cs движка). -->
    <DefineConstants>$(DefineConstants);KHAROS_MOD_SDK</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="build/**" />
    <None Include="build/**" />
  </ItemGroup>
  <ItemGroup>
    <!-- Детерминированная математика — тот же исходник, что у движка: биты модов и движка совпадают. -->
    <Compile Include="..\Kharos.Engine\Math\DetMath*.cs" Link="Math\%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MemoryPack" />
  </ItemGroup>
</Project>
