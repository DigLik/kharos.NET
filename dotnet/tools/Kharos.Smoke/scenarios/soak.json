{
  "about": "нагрузка (Н7.3): сервер и боты протокола без GPU ездят и воюют; ворота — нет обрывов, худший тик ≤ 50 мс, память не растёт после разгона",
  // Мод smoke: без защиты новичка — боты воюют сразу.
  "mods": ["smoke"],
  "steps": [
    { "do": "server" },
    // Время — --soak (по умолчанию 15m), число ботов — --bots (8).
    { "do": "soak" },
    { "do": "console", "line": "status", "expect": "^тик (?<tick>\\d+), сущностей (?<entities>\\d+)", "as": "status" },
    { "do": "stop", "code": 0 },
    { "do": "file", "path": "${server}/save.kharos" }
  ]
}
