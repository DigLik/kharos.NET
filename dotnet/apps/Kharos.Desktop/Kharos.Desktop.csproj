<Project Sdk="Microsoft.NET.Sdk">
  <!-- Десктоп: окно и ввод Silk.NET, хост одиночной игры в процессе (docs/dotnet.md, Р10). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>kharos</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Ловушка wasm роняет процесс с теневым стеком Windows (docs/dotnet.md, Н2). -->
    <CetCompat>false</CetCompat>
    <!-- dotnet publish apps/Kharos.Desktop -c Release -r win-x64: самодостаточная сборка NativeAOT. -->
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <DebugType>none</DebugType>
    <!-- Предупреждения отсечения и AOT дают зависимости (Silk.NET, Wasmtime, MemoryPack), не наш код: на публикации не ошибки. -->
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <IlcTreatWarningsAsErrors>false</IlcTreatWarningsAsErrors>
    <NoWarn>$(NoWarn);IL2104;IL3053;IL3000;IL3002</NoWarn>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>kharos.ico</ApplicationIcon>
    <!-- На публикации — только base (Н7-6); обычная сборка берёт все моды (hello нужен тестам). -->
    <KharosShipMods Condition="'$(KharosShipMods)' == '' and '$(_IsPublishing)' == 'true'">base</KharosShipMods>
  </PropertyGroup>
  <ItemGroup Condition="'$(_IsPublishing)' == 'true' and !$(RuntimeIdentifier.StartsWith('win'))">
    <!-- Значок и ярлык Linux кладутся в архив рядом с программой. -->
    <None Include="kharos.desktop;kharos.png" CopyToPublishDirectory="PreserveNewest" CopyToOutputDirectory="Never" />
  </ItemGroup>
  <ItemGroup>
    <!-- Моды рядом с программой: mod.json, data/*.json, schema/*.json (компоненты — без них хосту base нечего объявлять), i18n/*.json (словари мода, Н6-5) и wasm (после tools/build-mods.ps1); исходники и сборки не берутся. -->
    <ModFile Include="..\..\mods\*\mod.json;..\..\mods\*\*.wasm;..\..\mods\*\data\*.json;..\..\mods\*\schema\*.json;..\..\mods\*\i18n\*.json" />
    <!-- Публикация (Н7-6): только моды из KharosShipMods (по умолчанию base); hello — пример в репозитории, в сборки не идёт. -->
    <_ShipMod Include="$(KharosShipMods)" Condition="'$(KharosShipMods)' != ''" />
    <_AllMod Include="$([System.IO.Directory]::GetDirectories('$(MSBuildProjectDirectory)\..\..\mods'))" Condition="'$(KharosShipMods)' != ''" />
    <_SkipMod Include="@(_AllMod->'%(Filename)')" Exclude="@(_ShipMod)" />
    <ModFile Remove="@(_SkipMod->'..\..\mods\%(Identity)\**')" />
    <None Include="@(ModFile)" Link="mods\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Kharos.Client\Kharos.Client.csproj" />
    <ProjectReference Include="..\..\src\Kharos.Host\Kharos.Host.csproj" />
    <PackageReference Include="Silk.NET.Windowing" />
    <PackageReference Include="Silk.NET.Input" />
  </ItemGroup>
</Project>