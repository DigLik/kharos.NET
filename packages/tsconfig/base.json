{
  "$schema": "https://json.schemastore.org/tsconfig",
  "//": "Общее для всех пакетов. Окружения здесь нет (только ES2022): так собирается то, что обязано работать везде — симуляция, ECS, данные. Страница и сервер добавляют своё в dom.json и bun.json.",
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2022"],
    "types": [],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  }
}
